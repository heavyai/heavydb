{
  "usermeta": {
    "shortName": "ShaderCompilerTest-PointTest",
    "shaderArtifacts": [
      "builder", "spirv"
    ]
  },
  "width": $width,
  "height": $height,
  "data": [
    {
      "name": "contributions",
      "sql": "SELECT conv_4326_900913_x(lon) as x, conv_4326_900913_y(lat) as y, recipient_party as dim0, amount as val, rowid FROM contributions WHERE conv_4326_900913_x(lon) between $minXBounds and $maxXBounds and conv_4326_900913_y(lat) between $minYBounds and $maxYBounds LIMIT 2000000"
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": [ $minXBounds, $maxXBounds ],
      "range": "width"
    },
    {
      "name": "y",
      "type": "linear",
      "domain": [ $minYBounds, $maxYBounds ],
      "range": "height"
    }
  ],
  "marks": [
    {
      "type": "points",
      "from": { "data": "contributions" },
      "properties": {
        "size": 10,
        "x": { "scale": "x", "field": "x" },
        "y": { "scale": "y", "field": "y" },
        "fillColor": "deepskyblue",
        "strokeColor": "rgb(0, 0, 0)",
        "strokeWidth": 1.5,
        "shape": "circle"
      }
    }
  ]
}