//<extensions>
#extension GL_EXT_ray_tracing : enable
//</extensions>

layout(location = 0) rayPayloadInEXT vec3 hitValue;

void main()
{
    // Write something to ensure the shader was invoked
    // A malformed SBT may cause this to be skipped
    hitValue = vec3(0.0, 0.0, 0.2);
}
