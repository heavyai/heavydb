//<extensions>
#extension GL_EXT_ray_tracing : require
//</extensions>

//<includes>
#include "RaytracingTest/AABB_payload.glsl"
//</includes>

layout(location = 0) rayPayloadInEXT RayPayload rayPayload;

void main() {
  // View-independent background gradient to simulate a basic sky background
  const vec3 gradient_start = vec3(0.5, 0.6, 1.0);
  const vec3 gradient_end = vec3(0.6, 0.4, 0.2);

  // Write required outputs to payload
  rayPayload.color = mix(gradient_start, gradient_end, (gl_WorldRayDirectionEXT.y + 1.0) * 0.5);
  rayPayload.reflectivity = vec3(0.0);
}
