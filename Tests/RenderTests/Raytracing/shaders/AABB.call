//<extensions>
#extension GL_EXT_ray_tracing : enable
//</extensions>

layout(location = 1) callableDataInEXT vec3 callableValue;

void main() {
  // Generate a color using image UV for the pixel
  callableValue = vec3(0.5, vec2(gl_LaunchIDEXT.xy) / vec2(gl_LaunchSizeEXT.xy));
}
