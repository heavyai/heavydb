+
+/**
+ * @file xmltooling/XMLObject.h
+ * 
+ * Abstract interface to objects that can be manipulated in and out of XML form. 
+ */
+
+#ifndef __log_stubs__
+#define __log_stubs__
+
+#include <string>
+#include <vector>
+#include <set>
+#include <sstream>
+#include <sys/stat.h>
+
+// Here are some minimal interfaces used by opensaml and xmltools w/o any functionality.
+// The goal is to turn off logging and get rid of lib4{shib,cpp} dependency (LGPL)
+
+namespace logstubs {
+    class NDC {
+        public: 
+        static void clear() { } 
+        static const std::string get() { return ""; } 
+        static int getDepth() { return 0; } 
+        static std::string pop() { return ""; } 
+        static void push(const std::string&/* message*/) { } 
+        static void setMaxDepth(int/* maxDepth*/) { } 
+        NDC() { }
+        virtual ~NDC() { }
+    };
+
+    class ConfigureFailure : public std::runtime_error {
+        public:
+        ConfigureFailure(const std::string& reason) : std::runtime_error(reason) { }
+    };
+
+    class PropertyConfigurator {
+        public:
+        static void configure(const std::string&/* initFileName*/) { }
+    };
+
+    class Priority {
+        public: 
+        typedef enum {
+            EMERG, 
+            FATAL,
+            ALERT,
+            CRIT,
+            ERROR,
+            WARN,
+            NOTICE,
+            INFO,
+            DEBUG,
+            NOTSET
+        } PriorityLevel;
+     };
+
+     class Appender {
+        public:         
+        static Appender* getAppender(const std::string& name) { return nullptr; }
+        static bool reopenAll() { return true; }
+        static void closeAll() { }
+
+        protected:
+        Appender(const std::string&/* name*/) { }
+
+        public:
+        ~Appender() { }
+        virtual bool reopen() { return true; }
+        virtual void close() { }
+        const std::string getName() const { return ""; }
+    }; 
+    typedef std::set<Appender* > AppenderSet;
+
+    class OstreamAppender : public Appender {
+        public:
+        OstreamAppender(const std::string& name, std::ostream*/* stream*/) : Appender::Appender(name) { }
+        virtual ~OstreamAppender() { }
+        
+        virtual bool reopen() { return true; }
+        virtual void close() { }
+    };
+
+    class CategoryStream {
+        public:
+        inline Priority::PriorityLevel getPriority() const { 
+            return Priority::NOTSET; 
+        };
+        void flush() { }
+        template<typename T> CategoryStream& operator<<(const T&/* t*/) {
+            return *this;
+        }
+    };
+    inline CategoryStream& eol (CategoryStream& os) { return os; }
+
+    class Category { 
+        public:
+        static Category& getRoot() {
+            static Category root;
+            return root;
+        }
+
+        static Category& getInstance(const std::string&/* name*/) {
+            static Category instance;
+            return instance;
+        }
+         
+        static Category* exists(const std::string& name) {
+           return nullptr; 
+        }
+
+        static std::vector<Category*>* getCurrentCategories() { return {}; } 
+        static void shutdown() { } 
+        virtual ~Category() { }         
+        virtual const std::string getName() const { return ""; }         
+        virtual void setPriority(Priority::PriorityLevel/* priority*/) { } 
+        virtual Priority::PriorityLevel getPriority() const { return Priority::NOTSET; }
+        virtual Priority::PriorityLevel getChainedPriority() const { return Priority::NOTSET; }
+        virtual bool isPriorityEnabled(Priority::PriorityLevel/* priority*/) const { return false; }
+        virtual void addAppender(Appender*/* appender*/) { }
+        virtual void addAppender(Appender&/* appender*/) { }
+        inline void setAppender(Appender*/* appender*/) { }
+        inline void setAppender(Appender&/* appender*/) { }
+        virtual Appender* getAppender() const { return nullptr; }
+        virtual Appender* getAppender(const std::string&/* name*/) const  { return nullptr; }
+        virtual AppenderSet getAllAppenders() const { return {}; }
+        virtual void removeAllAppenders() { }
+        virtual void removeAppender(Appender*/* appender*/) { }
+        inline bool ownsAppender() const { return false; }
+        virtual bool ownsAppender(Appender*/* appender*/) { return false; }
+        virtual void setAdditivity(bool/* additivity*/) { }
+        virtual bool getAdditivity() const { return false; }
+        virtual Category* getParent() { return nullptr; }
+        virtual const Category* getParent() const { return nullptr; }
+        virtual void log(Priority::PriorityLevel/* priority*/, const char*/* stringFormat*/,
+                      ...) { }
+        virtual void log(Priority::PriorityLevel/* priority*/, 
+                      const std::string&/* message*/) { }
+        virtual void logva(Priority::PriorityLevel/* priority*/, 
+                        const char*/* stringFormat*/,
+                        va_list va) { }
+
+        void debug(const char*/* stringFormat*/, ...) { }
+        void debug(const std::string&/* message*/) { }
+        inline bool isDebugEnabled() const { return false; }
+        inline CategoryStream debugStream() {
+         return getStream(Priority::DEBUG);
+        }
+
+        void info(const char*/* stringFormat*/, ...) { }
+        void info(const std::string&/* message*/) { }
+        inline bool isInfoEnabled() const { return false; }
+        inline CategoryStream infoStream() {
+         return getStream(Priority::INFO);
+        }
+
+        void notice(const char*/* stringFormat*/, ...) { }
+        void notice(const std::string&/* message*/) { }
+        inline bool isNoticeEnabled() const { return false; }
+        inline CategoryStream noticeStream() {
+         return getStream(Priority::NOTICE);
+        }
+
+        void warn(const char*/* stringFormat*/, ...) { }
+        void warn(const std::string&/* message*/) { }
+        inline bool isWarnEnabled() const { return false; }
+        inline CategoryStream warnStream() {
+         return getStream(Priority::WARN);
+        };
+
+        void error(const char*/* stringFormat*/, ...) { }
+        void error(const std::string&/* message*/) { }
+        inline bool isErrorEnabled() const { return false; }
+        inline CategoryStream errorStream() {
+         return getStream(Priority::ERROR);
+        };
+
+        void crit(const char*/* stringFormat*/, ...) { }
+        void crit(const std::string&/* message*/) { }
+        inline bool isCritEnabled() const { return false; }
+        inline CategoryStream critStream() {
+         return getStream(Priority::CRIT);
+        };
+
+        void alert(const char*/* stringFormat*/, ...) { }
+        void alert(const std::string&/* message*/) { }
+        inline bool isAlertEnabled() const { return false; }
+        inline CategoryStream alertStream() throw() {
+         return getStream(Priority::ALERT);
+        };
+
+        void emerg(const char*/* stringFormat*/, ...) { }
+        void emerg(const std::string&/* message*/) { }
+        inline bool isEmergEnabled() const { return false; }
+        inline CategoryStream emergStream() {
+         return getStream(Priority::EMERG);
+        };
+
+        void fatal(const char*/* stringFormat*/, ...) { }
+        void fatal(const std::string&/* message*/) { }
+        inline bool isFatalEnabled() const { return false; }
+        inline CategoryStream fatalStream() {
+         return getStream(Priority::FATAL);
+        };
+
+        virtual CategoryStream getStream(Priority::PriorityLevel/* priority*/) { return null_stream_; }
+        virtual CategoryStream operator<<(Priority::PriorityLevel/* priority*/) {
+            return null_stream_;
+        }
+
+        private:
+        Category() { }
+        Category(const Category&/* other*/) { }
+        Category& operator=(const Category&/* other*/) { return *this; }
+        CategoryStream null_stream_;
+     };
+}
+
+#endif /* __log_stubs__ */
