diff -ruN xmltooling-3.0.4/xmltooling/LogStubs.h xmltooling-3.0.4-nologs/xmltooling/LogStubs.h
--- xmltooling-3.0.4/xmltooling/LogStubs.h	1970-01-01 03:00:00.000000000 +0300
+++ xmltooling-3.0.4-nologs/xmltooling/LogStubs.h	2018-09-18 15:45:13.713601000 +0300
@@ -0,0 +1,235 @@
