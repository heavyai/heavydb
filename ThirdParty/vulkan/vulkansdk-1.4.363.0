    -DSPIRV_CROSS_FORCE_PIC="ON" \
    --install-prefix "$ARCHDIR"
  cmake --build "${SPIRV_CROSS_DIR}/${BUILD_DIR}" -j $NUMJOBS
  cmake --install "${SPIRV_CROSS_DIR}/${BUILD_DIR}"
}

